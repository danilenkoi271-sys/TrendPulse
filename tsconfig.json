{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "supabase/functions/poll-views/handler.ts", "supabase/functions/poll-views/handler.test.ts"]
}
